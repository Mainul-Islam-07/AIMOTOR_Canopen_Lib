{
    "config_version": "1.0",
    "_comment": "Single configuration file for the AIMOTOR CANopen library. Edit paths / adapter / motors here - nothing is hardcoded in the Python sources.",

    "profile": "canable2",

    "paths": {
        "_comment": "base_dir null = folder of this library (derived from __file__). Put an absolute path here to move the library. Relative paths are resolved against base_dir.",
        "base_dir": null,
        "eds_dir": "Motor_Mapping",
        "log_dir": "Logs"
    },

    "adapters": {
        "canable2": {
            "interface": "gs_usb",
            "channel": "canable2",
            "index": 0,
            "bitrate": 500000,
            "notes": "DEFAULT. 250000 bps crashes libusb on this PC - keep 500000."
        },
        "canalystii": {
            "interface": "canalystii",
            "channel": 0,
            "bitrate": 500000,
            "notes": "Second adapter. Motor is wired to CAN1, which is channel 0."
        },
        "socketcan": {
            "interface": "socketcan",
            "channel": "can0",
            "bitrate": 500000,
            "notes": "For a future Linux / ROS2 host."
        },
        "virtual": {
            "interface": "virtual",
            "channel": "aimotor_test",
            "bitrate": 500000,
            "notes": "Offline dry run, no hardware needed."
        }
    },

    "network": {
        "master_node_name": "Master",
        "master_node_id": 127,
        "nmt_on_startup": "PRE-OPERATIONAL",
        "nmt_before_disconnect": "PRE-OPERATIONAL",
        "post_connect_delay_s": 0.2
    },

    "timing": {
        "delay_SDO_s": 0.0005,
        "delay_PDO_s": 0.0002,
        "sdo_response_timeout_s": 0.5,
        "sdo_max_retries": 3,
        "state_transition_timeout_s": 1.0,
        "brake_release_delay_s": 0.5
    },

    "shutdown": {
        "stop_before_disarm": true,
        "disarm_on_exit": true,
        "disconnect_on_exit": true,
        "os_exit_after_disconnect": true,
        "os_exit_code": 0,
        "notes": "os_exit_after_disconnect skips interpreter teardown, where the gs_usb libusb driver raises an access violation on this PC. The motor is always disarmed first. Set false on CANalyst-II for a normal exit."
    },

    "logging": {
        "DEBUG_INIT": true,
        "DEBUG_COMMAND": true,
        "DEBUG_FEEDBACK": true,
        "DEBUG_HEARTBEAT": true,
        "DEBUG_CONTROLWORD": true,
        "FAILURE_EXIT": false
    },

    "motor_defaults": {
        "eds_file": "AIMotorV2.3.eds",
        "mode": 3,
        "transport": "SDO",

        "pulses_per_rev": 1000,
        "gear_ratio": 1.0,
        "rated_torque_nm": 0.32,
        "rated_current_a": 6.0,

        "require_canopen_mode": true,
        "canopen_mode_value": 8,
        "abort_if_not_canopen_mode": true,
        "clear_fault_on_arm": true,
        "abort_if_fault_on_startup": true,

        "feedback": {
            "enabled": true,
            "poll_period_s": 0.1,
            "include_extended": true
        },

        "heartbeat": {
            "enabled": false,
            "producer_time_ms": 200,
            "timeout_ms": 1000,
            "restore_on_exit": true
        },

        "limits": {
            "_comment": "This drive has no 0x6072/0x6080 object, so limits MUST be enforced in software before every write.",
            "enforce_in_software": true,
            "max_velocity_rpm": 500.0,
            "max_acceleration_rpm_s": 1000.0,
            "max_deceleration_rpm_s": 1000.0,
            "max_position_pul": 2000000,
            "min_position_pul": -2000000,
            "max_torque_permille": 300
        },

        "profile": {
            "_comment": "Units are Pul/s and Pul/s^2. At 1000 pulses/rev: 16667 pul/s = 1000 rpm.",
            "maximal_profile_velocity_pulps": 16667,
            "profile_velocity_pulps": 8333,
            "profile_acceleration_pulps2": 16667,
            "profile_deceleration_pulps2": 16667,
            "quick_stop_deceleration_pulps2": 33333
        }
    },

    "motors": {
        "AIMotor_1": {
            "node_id": 1,
            "enabled": true,
            "description": "AIMOTOR low voltage servo, node 1, 500 kbps."
        },
        "AIMotor_2": {
            "node_id": 2,
            "enabled": false,
            "description": "Reserved for the second motor. Set its node id on the drive (H0C_00), then set enabled true."
        }
    }
}
